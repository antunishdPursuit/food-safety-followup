# Copy to .env for the app. The npm run data:* and seed:* commands read .env too when Node supports it
# (Node 20.12 or newer); otherwise export these variables in your shell. Never commit a real .env.

# Where the backend keeps its records. Default: .data
FSF_DATA_DIR=

# Optional. A free app token from data.cityofnewyork.us raises the NYC Open Data rate limit.
NYC_OPEN_DATA_APP_TOKEN=

# Hours before city data is shown as stale. Default: 72
FSF_STALE_AFTER_HOURS=

# Leave empty to keep POST /api/import off. To allow a scheduler to refresh city records,
# set a long random value and send it as the x-import-key header.
FSF_IMPORT_KEY=

# The shared manager access code. Leave empty for local use (changes are open). To go public, set a random value of
# at least 12 characters: every change (save a follow-up, link records, complete an action) then needs it. A code
# shorter than 12 characters blocks all changes. Change the code to sign everyone out.
FSF_ACCESS_CODE=

# Set to 1 to require the access code for reading too (a private deployment). Leave empty for a public, read-only demo.
FSF_PROTECT_READS=
